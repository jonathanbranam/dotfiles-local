# Added 2026-10-03 (dl-d927): rcrc is tracked per machine so ~/.rcrc is a symlink into this repo.
# vesta (the NUC) works from the shared worktree checkout rather than ~/dotfiles-local.
DOTFILES_DIRS="/srv/shared/work/dotfiles-work/dotfiles-local $HOME/dotfiles"
# Changed 2026-10-11 from "nuc": the NUC was renamed to vesta (host-nuc/ -> host-vesta/)
HOSTNAME="vesta"
# Added 2026-10-09: skip thoughtbot's git_template (shared git hooks); bridle installs its own hooks per clone
EXCLUDES="*.md LICENSE CODEOWNERS dotfiles:git_template/*"
