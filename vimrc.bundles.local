" themes
" Trimmed 2026-10-15: the human uses only their own colour setup, so only catppuccin stays
Plug 'catppuccin/vim', { 'as': 'catppuccin' }

" replace pbrisbin/vim-mkdir
" Changed 2026-10-09: UnPlug takes vim-plug's short name; 'pbrisbin/vim-mkdir' never matched,
" so vim-mkdir stayed installed alongside vim-automkdir
UnPlug 'vim-mkdir'
Plug 'benizi/vim-automkdir'

" Unplugged 2026-10-15: the human does not write Ruby or Elixir in Vim
UnPlug 'vim-elixir'
UnPlug 'vim-rails'
UnPlug 'vim-rake'
UnPlug 'vim-bundler'
UnPlug 'vim-ruby'

" Added 2026-10-09: fzf's `./install --all` rewrites ~/.fzf.zsh and appends to ~/.zshrc,
" both links into the dotfiles repos; --bin only fetches the binary. Re-declaring a plugin
" replaces thoughtbot's spec (vim-plug keys on the name), so no UnPlug is needed.
if !exists("g:brew_fzf_path") || !isdirectory(g:brew_fzf_path)
  Plug 'junegunn/fzf', { 'dir': '~/.fzf', 'do': './install --bin' }
endif

