#eval "$(rbenv init - --no-rehash)"
#export PATH="$HOME/.bin:$PATH"
#

setopt histignorespace

#source "$HOME/.zsh-nvm/zsh-nvm.plugin.zsh"
#antigen use oh-my-zsh
#antigen bundle lukechilds/zsh-nvm

# . $HOME/.asdf/asdf.sh

#antigen bundle git

shuf() { perl -MList::Util=shuffle -e 'print shuffle(<>);' "$@"; }

# FZF START

[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh

# FZF END

# beads_rust START
export RUST_LOG=warn
# beads_rust END

# NVM START
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion

# NVM END

# Branch local config
[[ -f ~/.zshrc.branch.local ]] && source ~/.zshrc.branch.local

# NUC (Linux). OS split (dl-c5fc): move to the Linux config (zsh/os/Linux.zsh),
# or keep one guarded copy in common config if the Mac needs it too.
# Added 2026-09-29 for rust on linux NUC (moved from zshenv.local 2026-09-30:
# thoughtbot's zshenv warns if zshenv.local edits PATH)
[[ -f "$HOME/.cargo/env" ]] && . "$HOME/.cargo/env"
