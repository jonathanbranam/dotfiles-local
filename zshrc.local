#eval "$(rbenv init - --no-rehash)"
#export PATH="$HOME/.bin:$PATH"
#

setopt histignorespace

#source "$HOME/.zsh-nvm/zsh-nvm.plugin.zsh"
#antigen use oh-my-zsh
#antigen bundle lukechilds/zsh-nvm

# . $HOME/.asdf/asdf.sh

#antigen bundle git

shuf() { perl -MList::Util=shuffle -e 'print shuffle(<>);' "$@"; }

# FZF START

[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh

# FZF END

# beads_rust START
export RUST_LOG=warn
# beads_rust END

# NVM START
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion

# NVM END

# Moved 2026-09-30 from zshrc.branch.local (dl-c5fc): common config, each guarded on existence

# Local scripts that shouldn't be in github
[[ -d "$HOME/.local/bin" ]] && export PATH="$HOME/.local/bin:$PATH"

# pyenv
if [[ -d "$HOME/.pyenv" ]]; then
  export PYENV_ROOT="$HOME/.pyenv"
  export PATH="${PYENV_ROOT}/shims:${PATH}"
fi

export RIPGREP_CONFIG_PATH="$HOME/.ripgreprc"

# Added 2026-09-29 for rust on linux NUC (moved from zshenv.local 2026-09-30:
# thoughtbot's zshenv warns if zshenv.local edits PATH). The single cargo load,
# rustup-managed; env file prepends ~/.cargo/bin only if missing
[[ -f "$HOME/.cargo/env" ]] && . "$HOME/.cargo/env"

export GPG_TTY="$(tty)"

# Per-OS config (Darwin.zsh, Linux.zsh) under zsh/os/, deliberately not zsh/configs/
# Added 2026-09-30 (dl-c5fc) to replace zshrc.branch.local, which loaded Mac paths everywhere
[[ -f ~/.zsh/os/$(uname -s).zsh ]] && source ~/.zsh/os/$(uname -s).zsh

# Per-machine config from host-<name>/zshrc.host (rcup links it only on that machine)
# Added 2026-10-03 (dl-b25b) for settings that differ between machines, not OSes
[[ -f ~/.zshrc.host ]] && source ~/.zshrc.host

# Warn at launch about missing tools these dotfiles expect (package names work for brew and apt)
# Added 2026-10-14: remus lacked jq, so claude-settings-sync failed silently during rcup
# nvim listed ahead of switching from vim; rcup, gh (pr aliases), git-lfs (gitconfig.local filter) added the same day
() {
  local -A pkg=(vim vim nvim neovim rg ripgrep fzf fzf jq jq tmux tmux rcup rcm gh gh git-lfs git-lfs)
  local cmd; local -a missing
  for cmd in vim nvim rg fzf jq tmux rcup gh git-lfs; do (( $+commands[$cmd] )) || missing+=($pkg[$cmd]); done
  (( $#missing )) || return 0
  local install="sudo apt-get install"
  [[ $OSTYPE == darwin* ]] && install="brew install"
  print -u2 "dotfiles: missing ${(j:, :)missing}; install with: $install $missing"
}
